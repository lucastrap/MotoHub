# ─────────────────────────────────────────────────────────────
# MotoTrack   modèle de configuration
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` est exclu du versionnement (cf. .gitignore) : ne jamais y committer de secret.
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL.

DATABASE_URL="postgresql://mototrack:mototrack_password@localhost:5432/mototrack_db?schema=public"

# Connexion directe 
JWT_SECRET="remplacer-par-un-secret-de-32-caracteres-minimum"

# URL publique de l'application.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Niveau de journalisation Winston).
LOG_LEVEL="info"


# DSN du projet Sentry  collecte des erreurs runtime.
NEXT_PUBLIC_SENTRY_DSN=""

# Organisation et projet Sentry utilisés par le plugin de build.

SENTRY_ORG=""
SENTRY_PROJECT=""
